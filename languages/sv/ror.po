#: system/AppCommandLine.cpp:165
msgid "Command Line Arguments"
msgstr "Kommandoradsargument"

#: system/AppCommandLine.cpp:166
msgid ""
"--help (this)\n"
"-map <map> (loads map on startup)\n"
"-pos <Vect> (overrides spawn position)\n"
"-rot <float> (overrides spawn rotation)\n"
"-truck <truck> (loads truck on startup)\n"
"-truckconfig <section>\n"
"-enter (player enters the selected truck)\n"
"-resume loads previous autosave\n"
"-checkcache forces cache update\n"
"-version shows the version information\n"
"-joinserver=<server>:<port> (join multiplayer server)\n"
"-runscript <filename> (load script, can be repeated)\n"
"For example: RoR.exe -map simple2 -pos '518 0 518' -rot 45 -truck semi.truck "
"-enter"
msgstr ""
"--help (visa den här hjälpen)\n"
"-map <map> (läs in kartan vid start)\n"
"-pos <Vect> (åsidosätt startpositionen)\n"
"-rot <float> (åsidosätt rotationen vid start)\n"
"-truck <truck> (läs in lastbilen vid start)\n"
"-truckconfig <section>\n"
"-enter (låt spelaren stiga in i den valda lastbilen)\n"
"-resume läs in den senaste automatiska sparningen\n"
"-checkcache tvinga fram en uppdatering av cachen\n"
"-version visa versionsinformation\n"
"-joinserver=<server>:<port> (anslut till en flerspelarserver)\n"
"-runscript <filename> (läs in ett skript, kan anges flera gånger)\n"
"Exempel: RoR.exe -map simple2 -pos '518 0 518' -rot 45 -truck semi.truck -"
"enter"

